# Required (at least one provider API key)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional - Model Provider Configuration
# Switch all agents to a different provider (default: openai)
# MODEL_PROVIDER=anthropic
#
# Override specific tiers (format: provider:model-id)
# MODEL_REASONING=openai:o3-mini
# MODEL_SMART=anthropic:claude-sonnet-4-20250514
# MODEL_FAST=anthropic:claude-haiku-4-5-20251001
# MODEL_NANO=openai:gpt-4.1-nano
#
# Override web search provider independently of model provider
# WEB_SEARCH_PROVIDER=openai
#
# Override transcription provider independently of model provider
# (only openai available currently; falls back to openai automatically)
# TRANSCRIPTION_PROVIDER=openai

# Optional - Memory Persistence
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# DEBUG_AGENTS=true